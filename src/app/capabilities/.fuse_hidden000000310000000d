/* ------------------------------------------------------------------ */
/*  SVG Pattern Components                                             */
/* ------------------------------------------------------------------ */

function SvgPattern({ pattern, color }: { pattern: string; color: string }) {
  switch (pattern) {
    case 'grid':
      return (
        <svg className="absolute inset-0 w-full h-full opacity-20" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <pattern id="grid-p" width="40" height="40" patternUnits="userSpaceOnUse">
              <path d="M 40 0 L 0 0 0 40" fill="none" stroke={color} strokeWidth="0.5" />
            </pattern>
          </defs>
          <rect width="100%" height="100%" fill="url(#grid-p)" />
        </svg>
      );
    case 'circles':
      return (
        <svg className="absolute inset-0 w-full h-full opacity-15" xmlns="http://www.w3.org/2000/svg">
          {[...Array(5)].map((_, i) => (
            <circle
              key={i}
              cx={`${20 + i * 15}%`}
              cy={`${30 + (i % 3) * 20}%`}
              r={30 + i * 12}
              fill="none"
              stroke={color}
              strokeWidth="0.5"
            />
          ))}
        </svg>
      );
    case 'waves':
      return (
        <svg className="absolute inset-0 w-full h-full opacity-15" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 200" preserveAspectRatio="none">
          {[0, 1, 2, 3].map((i) => (
            <path
              key={i}
              d={`M0,${60 + i * 30} Q100,${30 + i * 30} 200,${60 + i * 30} T400,${60 + i * 30}`}
              fill="none"
              stroke={color}
              strokeWidth="0.8"
            />
          ))}
        </svg>
      );
    case 'dots':
      return (
        <svg className="absolute inset-0 w-full h-full opacity-20" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <pattern id="dots-p" width="20" height="20" patternUnits="userSpaceOnUse">
              <circle cx="10" cy="10" r="1.5" fill={color} />
            </pattern>
          </defs>
          <rect width="100%" height="100%" fill="url(#dots-p)" />
        </svg>
      );
    case 'mesh':
      return (
        <svg className="absolute inset-0 w-full h-full opacity-15" xmlns="http://www.w3.org/2000/svg">
          {[...Array(8)].map((_, i) => (
            <line key={`a${i}`} x1={`${i * 15}%`} y1="0%" x2={`${100 - i * 15}%`} y2="100%" stroke={color} strokeWidth="0.4" />
          ))}
          {[...Array(8)].map((_, i) => (
            <line key={`b${i}`} x1={`${100 - i * 15}%`} y1="0%" x2={`${i * 15}%`} y2="100%" stroke={color} strokeWidth="0.4" />
          ))}
        </svg>
      );
    case 'diagonal':
      return (
        <svg className="absolute inset-0 w-full h-full opacity-15" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <pattern id="diag-p" width="30" height="30" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
              <line x1="0" y1="0" x2="0" y2="30" stroke={color} strokeWidth="0.5" />
            </pattern>
          </defs>
          <rect width="100%" height="100%" fill="url(#diag-p)" />
        </svg>
      );
    case 'hexagons':
      return (
        <svg className="absolute inset-0 w-full h-full opacity-15" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <pattern id="hex-p" width="56" height="100" patternUnits="userSpaceOnUse" patternTransform="scale(0.6)">
              <path d="M28 66L0 50L0 16L28 0L56 16L56 50L28 66L28 100" fill="none" stroke={color} strokeWidth="0.8" />
              <path d="M28 0L28 34L0 50L0 84L28 100L56 84L56 50L28 34" fill="none" stroke={color} strokeWidth="0.8" />
            </pattern>
          </defs>
          <rect width="100%" height="100%" fill="url(#hex-p)" />
        </svg>
      );
    default:
      return null;
  }
}

