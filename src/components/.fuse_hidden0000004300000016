'use client';

import Link from 'next/link';
import { CaseStudy } from '@/data/caseStudies';
import { CTASection } from '@/components/CTASection';
import { useInView } from '@/hooks/useInView';

function HeroSection({
  client,
  heroMetric,
  heroMetricLabel,
}: {
  client: string;
  heroMetric: string;
  heroMetricLabel: string;
}) {
  const { ref, inView } = useInView({ threshold: 0.15 });

  return (
    <section className="relative bg-tt-black overflow-hidden">
      <div className="pointer-events-none absolute inset-0" aria-hidden="true">
        <div className="absolute top-[-20%] left-[-10%] h-[600px] w-[600px] rounded-full bg-tt-teal/[.06] blur-[120px]" />
        <div className="absolute bottom-[-15%] right-[-5%] h-[400px] w-[400px] rounded-full bg-tt-orange/[.04] blur-[100px]" />
      </div>
      <div
        ref={ref}
        className={`relative z-10 mx-auto max-w-5xl px-6 py-24 transition-all duration-700 ${
          inView ? 'opacity-100 translate-y-0' : 'opacity-0 translate-y-8'
        }`}
      >
        <Link
          href="/case-studies"
          className="inline-flex items-center gap-1 text-tt-gray-400 hover:text-tt-teal transition-colors text-sm mb-10"
        >
          &larr; Back to Case Studies
        </Link>
        <p className="text-tt-teal uppercase tracking-wider text-sm font-semibold mb-4">
          {client}
        </p>
        <p className="text-7xl md:text-9xl font-extrabold text-white leading-none tracking-tight">
          {heroMetric}
        </p>
        <p className="mt-4 text-2xl text-tt-gray-400">{heroMetricLabel}</p>
      </div>
    </section>
  );
}

function SummarySection({ summary }: { summary: string }) {
  const { ref, inView } = useInView({ threshold: 0.15 });
  return (
    <section className="bg-white py-16 px-6">
      <div
        ref={ref}
        className={`mx-auto max-w-3xl text-center transition-all duration-700 ${
          inView ? 'opacity-100 translate-y-0' : 'opacity-0 translate-y-8'
        }`}
      >
        <p className="text-2xl font-medium text-tt-gray-900 leading-relaxed">
          {summary}
        </p>
      </div>
    </section>
  );
}

function ChallengeSolutionSection({
  challenge,
  solution,
}: {
  challenge: string;
  solution: string;
}) {
  const { ref, inView } = useInView({ threshold: 0.1 });
  return (
    <section className="bg-white px-6 pb-20">
      <div
        ref={ref}
        className={`mx-auto max-w-6xl grid gap-16 md:grid-cols-2 transition-all duration-700 ${
          inView ? 'opacity-100 translate-y-0' : 'opacity-0 translate-y-8'
        }`}
      >
        <div>
          <div className="border-t-2 border-tt-teal pt-6 mb-6">
            <h2 className="text-2xl font-bold text-tt-gray-900">The Challenge</h2>
          </div>
          <p className="text-tt-gray-600 leading-relaxed text-lg">{challenge}</p>
        </div>
        <div>
          <div className="border-t-2 border-tt-teal pt-6 mb-6">
            <h2 className="text-2xl font-bold text-tt-gray-900">Our Approach</h2>
          </div>
          <p className="text-tt-gray-600 leading-relaxed text-lg">{solution}</p>
        </div>
      </div>
    </section>
  );
}

function ResultsSection({ results }: { results: { metric: string; value: string }[] }) {
  const { ref, inView } = useInView({ threshold: 0.1 });
  return (
    <section className="bg-tt-gray-50 py-20 px-6">
      <div
        ref={ref}
        className={`mx-auto max-w-6xl transition-all duration-700 ${
          inView ? 'opacity-100 translate-y-0' : 'opacity-0 translate-y-8'
        }`}
      >
        <h2 className="text-3xl md:text-4xl font-bold text-tt-gray-900 text-center mb-14">
          The Results
        </h2>
        <div
          className={`grid gap-6 ${
            results.length === 1
              ? 'max-w-sm mx-auto'
              : results.length === 2
              ? 'max-w-2xl mx-auto sm:grid-cols-2'
              : results.length === 3
              ? 'sm:grid-cols-3'
              : 'sm:grid-cols-2 lg:grid-cols-4'
          }`}
        >
          {results.map((result, i) => (
            <div
              key={result.metric}
              className="bg-white rounded-2xl p-8 shadow-sm text-center transition-all duration-300 hover:shadow-md hover:-translate-y-1"
              style={{ animationDelay: `${i * 100}ms` }}
            >
              <p className="text-4xl font-extrabold text-tt-teal">{result.value}</p>
              <p className="text-sm text-tt-gray-600 mt-2">{result.metric}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  );
}

function TestimonialSection({
  testimonial,
}: {
  testimonial: { quote: string; name: string; title: string; company: string };
}) {
  const { ref, inView } = useInView({ threshold: 0.15 });
  return (
    <section className="bg-tt-black py-20 px-6">
      <div
        ref={ref}
        className={`mx-auto max-w-4xl text-center transition-all duration-700 ${
          inView ? 'opacity-100 translate-y-0' : 'opacity-0 translate-y-8'
        }`}
      >
        <span className="block text-6xl leading-none text-tt-teal font-serif mb-4 select-none" aria-hidden="true">
          &ldquo;
        </span>
        <blockquote className="text-2xl text-tt-gray-300 italic leading-relaxed">
          {testimonial.quote}
        </blockquote>
        <span className="block text-6xl leading-none text-tt-teal font-serif mt-4 select-none" aria-hidden="true">
          &rdquo;
        </span>
        <div className="mt-8">
          <p className="text-tt-gray-500 text-sm">
            {testimonial.name}, {testimonial.title} &mdash; {testimonial.company}
          </p>
        </div>
      </div>
    </section>
  );
}

export function CaseStudyPageClient({ caseStudy }: { caseStudy: CaseStudy }) {
  return (
    <>
      <HeroSection
        client={caseStudy.client}
        heroMetric={caseStudy.heroMetric}
        heroMetricLabel={caseStudy.heroMetricLabel}
      />
      <SummarySection summary={caseStudy.summary} />
      <ChallengeSolutionSection challenge={caseStudy.challenge} solution={caseStudy.solution} />
      <ResultsSection results={caseStudy.results} />
      {caseStudy.testimonial && <TestimonialSection testimonial={caseStudy.testimonial} />}
      <CTASection
        headline="Get Results Like These"
        subheadline="Book a free audit and see what's possible for your brand."
        primaryCTA={{ text: 'Book Your Free Audit', href: '/get-started' }}
        secondaryCTA={{ text: 'View More Case Studies', href: '/case-studies' }}
        dark
      />
    </>
  );
}
